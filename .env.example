# For local development without Docker, SQLite is used by default.
# Docker Compose overrides DATABASE_URL to use PostgreSQL.
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_FROM_openssl_rand_hex_32
DATABASE_URL=sqlite:///./ube.db
# Supabase: copy Connect > Session pooler URI; URL-encode the DB password.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
UPLOAD_DIR=./uploads
# Local Python runs only; Docker Compose enables this for its localhost port.
ENABLE_MODEL_TEST_UI=false
CORS_ORIGINS=http://localhost:3000
# When your own Python AI service is ready, provide its inference URL.
# AI_SERVICE_URL=http://inference:8001/predict
# Real hosted detection. Keep this private key in .env, never in the test UI.
AI_PROVIDER=roboflow
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=krittin-wankundee/pallet-detection-zmufh-3-rfdetr-small-t1
# Detection threshold in [0,1]. This is not a quality Pass/Fail tolerance.
ROBOFLOW_CONFIDENCE=0.25
ROBOFLOW_TARGET_CLASSES=pallet,pallet-detection,wooden-pallet
# Automatic visible-stack checks (provisional criteria from the supplied notebook).
# Install requirements-sam2.txt and run python -m app.prepare_sam2 first.
AUTO_CHECK_ENABLED=true
SAM2_DEVICE=cpu
# Optional absolute path; default is .model-cache/sam2.1-hiera-small next to this file.
# SAM2_MODEL_DIR=/path/to/model
AUTO_CHECK_EXPECTED_LAYERS=8
AUTO_CHECK_MAX_TILT_DEG=3
AUTO_CHECK_MAX_OFFSET_PERCENT=4
AUTO_CHECK_CAMERA_ROLL_DEG=0
# Only used when running: python -m app.seed
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
# Used by Docker Compose only, use a long password without : / @ % or other URL-special characters in this starter.
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DB_PASSWORD
